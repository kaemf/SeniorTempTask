{
  "name": "@loan-review/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/router.d.ts",
  "exports": {
    "./router": {
      "types": "./src/router.ts",
      "default": "./src/router.ts"
    },
    "./types": {
      "types": "./src/domain.ts",
      "default": "./src/domain.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
