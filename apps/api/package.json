    "lint": "eslint --config ../../packages/config/eslint.config.mjs . --max-warnings=0"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@loan-review/db": "workspace:*",
    "@trpc/server": "^11.5.1",
    "fastify": "^5.6.0",
    "superjson": "^2.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@loan-review/config": "workspace:*",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
